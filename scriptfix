function initIbcDashboard(data) {
        const dash = document.getElementById("ibcDashboardArea");
        if (dash) dash.style.display = "block";
        const insp = document.getElementById("ibcDrilldownInspector");
        if (insp) insp.style.display = "none";

        const mBtn = document.getElementById("ibcMasterDownloadBtn");
        if (mBtn) mBtn.href = data.master_download_url || "#";
        const zBtn = document.getElementById("ibcZipDownloadBtn");
        if (zBtn) zBtn.href = data.zip_download_url || "#";
        const wBtn = document.getElementById("ibcWordDownloadBtn");
        if (wBtn) wBtn.href = data.word_download_url || "#";

        const bsegs = data.bseg_summary || [];
        const bills = data.bill_summary || [];

        // Compute KPIs directly from summary rows so it never shows 0/0
        let k = Array.isArray(data.kpis) ? (data.kpis[0] || {}) : (data.kpis || {});
        const totalBills = k.total_bills || bills.length || 1;
        const totalBsegs = k.total_bsegs || bsegs.length || 0;
        const matchedRows = k.matched_rows !== undefined ? k.matched_rows : (
            bills.length ? bills.reduce((a, r) => a + (r.Total_row_validated_match || 0), 0)
                         : bsegs.reduce((a, r) => a + (r.Total_row_validated_match || 0), 0)
        );
        const mismatchedRows = k.mismatched_rows !== undefined ? k.mismatched_rows : (
            bills.length ? bills.reduce((a, r) => a + (r.Total_row_validated_mismatch || 0), 0)
                         : bsegs.reduce((a, r) => a + (r.Total_row_validated_mismatch || 0), 0)
        );
        const excRows = k.approved_exceptions || bsegs.reduce((a, r) => a + (r.exceptions_count || 0), 0);

        const elPairs = document.getElementById("ibcKpiPairs");
        if (elPairs) elPairs.textContent = `${totalBills} / ${totalBsegs}`;
        const elMatch = document.getElementById("ibcKpiMatch");
        if (elMatch) elMatch.textContent = matchedRows.toLocaleString();
        const elMism = document.getElementById("ibcKpiMismatch");
        if (elMism) elMism.textContent = mismatchedRows.toLocaleString();
        const elExc = document.getElementById("ibcKpiExceptions");
        if (elExc) elExc.textContent = excRows.toLocaleString();

        // Populate Rate Schedule Dropdown
        const rateSelect = document.getElementById("ibcRateFilter");
        if (rateSelect) {
            const uniqueRates = Array.from(new Set(bsegs.map(r => r.Rate_cd).filter(Boolean))).sort();
            rateSelect.innerHTML = `<option value="ALL">All Rates (${uniqueRates.length})</option>` +
                uniqueRates.map(r => `<option value="${r}">${r}</option>`).join("");
        }

        // Compute Table Stats from summary rows if not directly in payload
        let tStats = data.table_chart_stats || {};
        if (Object.keys(tStats).length === 0) {
            if (data.scope !== "bseg_only" && bills.length) {
                tStats["CI_BILL_MSGS"] = {
                    match: bills.reduce((a, r) => a + (r.CI_BILL_MSGS_match || 0), 0),
                    mismatch: bills.reduce((a, r) => a + (r.CI_BILL_MSGS_mismatch || 0), 0)
                };
            }
            ["CI_BSEG_MSG", "CI_BSEG_CALC", "CI_BSEG_READ", "CI_BSEG_SQ", "CI_BSEG_CALC_LN"].forEach(t => {
                tStats[t] = {
                    match: bsegs.reduce((a, r) => a + (r[`${t}_match`] || 0), 0),
                    mismatch: bsegs.reduce((a, r) => a + (r[`${t}_mismatch`] || 0), 0)
                };
            });
        }

        renderIbcCharts(
            { matched_rows: matchedRows, mismatched_rows: mismatchedRows, approved_exceptions: excRows },
            tStats
        );

        const billTabBtn = document.getElementById("tabBtnBillLevel");
        if (data.scope === "bseg_only") {
            if (billTabBtn) billTabBtn.style.display = "none";
            switchIbcTableTab("bseg");
        } else {
            if (billTabBtn) billTabBtn.style.display = "inline-block";
            switchIbcTableTab("bill");
        }

        renderIbcTables();
    }

    function renderIbcCharts(kpis, tableStats) {
        const box1 = document.getElementById("ibcOverallChartBox");
        const box2 = document.getElementById("ibcTableBarChartBox");
        if (!box1 || !box2) return;

        const matched = kpis.matched_rows || 0;
        const mismatched = kpis.mismatched_rows || 0;
        const exc = kpis.approved_exceptions || 0;
        const total = Math.max(matched + mismatched + exc, 1);

        const r = 56, cx = 80, cy = 88, circ = 2 * Math.PI * r;
        const mLen = (matched / total) * circ;
        const mmLen = (mismatched / total) * circ;
        const exLen = (exc / total) * circ;

        const mPct = ((matched / total) * 100).toFixed(1);
        const mmPct = ((mismatched / total) * 100).toFixed(1);
        const exPct = ((exc / total) * 100).toFixed(1);

        box1.innerHTML = `
            <svg viewBox="0 0 310 175" width="100%" height="175">
                <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="#edf2f7" stroke-width="22"/>
                <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="#16a34a" stroke-width="22"
                    stroke-dasharray="${mLen} ${circ}" stroke-dashoffset="0" transform="rotate(-90 ${cx} ${cy})"
                    style="cursor:pointer;"
                    onmouseover="this.setAttribute('stroke-width','27'); showIbcTooltip(event, '🟢 <b>Matched Rows</b><br>Count: ${matched.toLocaleString()}<br>Share: ${mPct}%')"
                    onmousemove="showIbcTooltip(event, '🟢 <b>Matched Rows</b><br>Count: ${matched.toLocaleString()}<br>Share: ${mPct}%')"
                    onmouseout="this.setAttribute('stroke-width','22'); hideIbcTooltip()"/>
                <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="#dc2626" stroke-width="22"
                    stroke-dasharray="${mmLen} ${circ}" stroke-dashoffset="${-mLen}" transform="rotate(-90 ${cx} ${cy})"
                    style="cursor:pointer;"
                    onmouseover="this.setAttribute('stroke-width','27'); showIbcTooltip(event, '🔴 <b>Mismatched Rows</b><br>Count: ${mismatched.toLocaleString()}<br>Share: ${mmPct}%')"
                    onmousemove="showIbcTooltip(event, '🔴 <b>Mismatched Rows</b><br>Count: ${mismatched.toLocaleString()}<br>Share: ${mmPct}%')"
                    onmouseout="this.setAttribute('stroke-width','22'); hideIbcTooltip()"/>
                <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="#0284c7" stroke-width="22"
                    stroke-dasharray="${exLen} ${circ}" stroke-dashoffset="${-(mLen + mmLen)}" transform="rotate(-90 ${cx} ${cy})"
                    style="cursor:pointer;"
                    onmouseover="this.setAttribute('stroke-width','27'); showIbcTooltip(event, '🔵 <b>25.4 Exceptions</b><br>Count: ${exc.toLocaleString()}<br>Share: ${exPct}%')"
                    onmousemove="showIbcTooltip(event, '🔵 <b>25.4 Exceptions</b><br>Count: ${exc.toLocaleString()}<br>Share: ${exPct}%')"
                    onmouseout="this.setAttribute('stroke-width','22'); hideIbcTooltip()"/>
                <text x="${cx}" y="${cy - 2}" text-anchor="middle" font-size="14" font-weight="bold" fill="#003366">${mPct}%</text>
                <text x="${cx}" y="${cy + 12}" text-anchor="middle" font-size="9" fill="#64748b">Pass Rate</text>
                <rect x="160" y="45" width="10" height="10" rx="2" fill="#16a34a"/><text x="175" y="54" font-size="10.5" font-weight="600" fill="#1e293b">Matched (${matched})</text>
                <rect x="160" y="72" width="10" height="10" rx="2" fill="#dc2626"/><text x="175" y="81" font-size="10.5" font-weight="600" fill="#1e293b">Mismatch (${mismatched})</text>
                <rect x="160" y="99" width="10" height="10" rx="2" fill="#0284c7"/><text x="175" y="108" font-size="10.5" font-weight="600" fill="#1e293b">25.4 Exc (${exc})</text>
            </svg>
        `;

        const tbls = Object.keys(tableStats);
        const maxVal = Math.max(...tbls.map(t => Math.max(tableStats[t].match || 0, tableStats[t].mismatch || 0)), 1);
        const baseY = 145, chartH = 112, colW = 430 / Math.max(tbls.length, 1);

        let barsHtml = "";
        tbls.forEach((t, i) => {
            const shortName = t.replace("CI_", "");
            const m = tableStats[t].match || 0;
            const mm = tableStats[t].mismatch || 0;
            const tot = m + mm;
            const passPct = tot > 0 ? ((m / tot) * 100).toFixed(1) : "100.0";
            const hm = (m / maxVal) * chartH;
            const hmm = (mm / maxVal) * chartH;
            const xc = 25 + i * colW + colW / 2;
            const bw = 14;

            const tipM = `<b>${t}</b><br>🟢 Matched: ${m} rows (${passPct}%)<br>Total Rows: ${tot}`;
            const tipMM = `<b>${t}</b><br>🔴 Mismatch: ${mm} rows<br>Total Rows: ${tot}`;

            barsHtml += `
                <rect x="${xc - bw - 1}" y="${baseY - hm}" width="${bw}" height="${Math.max(hm, 2)}" rx="2" fill="#16a34a" style="cursor:pointer;"
                    onmouseover="this.setAttribute('opacity','0.75'); showIbcTooltip(event, '${tipM}')"
                    onmousemove="showIbcTooltip(event, '${tipM}')"
                    onmouseout="this.setAttribute('opacity','1'); hideIbcTooltip()"/>
                ${m > 0 ? `<text x="${xc - bw/2 - 1}" y="${baseY - hm - 3}" text-anchor="middle" font-size="8" font-weight="bold" fill="#15803d">${m}</text>` : ''}
                <rect x="${xc + 1}" y="${baseY - hmm}" width="${bw}" height="${Math.max(hmm, 2)}" rx="2" fill="#dc2626" style="cursor:pointer;"
                    onmouseover="this.setAttribute('opacity','0.75'); showIbcTooltip(event, '${tipMM}')"
                    onmousemove="showIbcTooltip(event, '${tipMM}')"
                    onmouseout="this.setAttribute('opacity','1'); hideIbcTooltip()"/>
                ${mm > 0 ? `<text x="${xc + bw/2 + 1}" y="${baseY - hmm - 3}" text-anchor="middle" font-size="8" font-weight="bold" fill="#dc2626">${mm}</text>` : ''}
                <text x="${xc}" y="${baseY + 14}" text-anchor="middle" font-size="8" font-weight="bold" fill="#334155">${shortName}</text>
            `;
        });

        box2.innerHTML = `
            <svg viewBox="0 0 475 175" width="100%" height="175">
                <line x1="15" y1="${baseY}" x2="465" y2="${baseY}" stroke="#cbd5e0" stroke-width="1.5"/>
                <rect x="330" y="4" width="9" height="9" rx="2" fill="#16a34a"/><text x="343" y="12" font-size="9" font-weight="bold" fill="#334155">Match</text>
                <rect x="385" y="4" width="9" height="9" rx="2" fill="#dc2626"/><text x="398" y="12" font-size="9" font-weight="bold" fill="#334155">Mismatch</text>
                ${barsHtml}
            </svg>
        `;
    }