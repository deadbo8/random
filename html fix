def load_season_config_metadata(base_dir: str) -> dict:
    """
    Loads Rate Schedule -> Type (Category) and Meter Type mapping
    from storage/db_storage.xlsx (sheet: season_config).
    """
    xlsx_path = os.path.join(base_dir, "storage", "db_storage.xlsx")
    rate_map = {}
    types_set = set()
    meter_types_set = set()

    if os.path.exists(xlsx_path):
        try:
            df = pd.read_excel(xlsx_path, sheet_name="season_config", dtype=str)
            col_map = {str(c).strip().lower(): c for c in df.columns}
            type_col = col_map.get("type")
            rate_col = col_map.get("rate schedule") or col_map.get("rate_schedule")
            meter_col = col_map.get("meter type") or col_map.get("meter_type")

            for _, row in df.iterrows():
                r_cd = str(row.get(rate_col, "") or "").strip().upper() if rate_col else ""
                if not r_cd or r_cd == "NAN":
                    continue
                t_val = str(row.get(type_col, "") or "").strip() if type_col else ""
                m_val = str(row.get(meter_col, "") or "").strip().upper() if meter_col else ""
                if t_val.lower() == "nan":
                    t_val = ""
                if m_val.lower() == "nan":
                    m_val = ""

                rate_map[r_cd] = {
                    "type": t_val or "Other",
                    "meter_type": m_val or "-",
                }
                if t_val:
                    types_set.add(t_val)
                if m_val:
                    meter_types_set.add(m_val)
        except Exception as e:
            print(f"[IBC season_config Load Warning] {e}")

    return {
        "rate_map": rate_map,
        "types": sorted(types_set),
        "meter_types": sorted(meter_types_set),
    }