<!-- Dedicated Filters for Rate Breakdown Chart (Type & Meter Type from db_storage.xlsx -> season_config) -->
<div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 10px; background: #f8fafc; padding: 8px 10px; border: 1px solid #e2e8f0; border-radius: 4px;">
    <select id="ibcRateCatTypeFilter" onchange="renderIbcRateBreakdown()" style="padding: 5px 10px; border: 1px solid #cbd5e0; border-radius: 4px; font-size: 12px; color: #1a202c; background: #fff;">
        <option value="ALL">All Types (season_config)</option>
    </select>
    <select id="ibcRateCatMeterFilter" onchange="renderIbcRateBreakdown()" style="padding: 5px 10px; border: 1px solid #cbd5e0; border-radius: 4px; font-size: 12px; color: #1a202c; background: #fff;">
        <option value="ALL">All Meter Types (season_config)</option>
    </select>
    <select id="ibcRateOwnRateFilter" onchange="renderIbcRateBreakdown()" style="padding: 5px 10px; border: 1px solid #cbd5e0; border-radius: 4px; font-size: 12px; color: #1a202c; background: #fff;">
        <option value="ALL">All Rates</option>
    </select>
    <button type="button" onclick="resetIbcRateSectionFilters()" style="padding: 5px 10px; background: #64748b; color: #fff; border: none; border-radius: 4px; font-size: 11.5px; font-weight: 600; cursor: pointer;">
        ↺ Reset Chart Filter
    </button>
</div>