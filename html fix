function initIbcDashboard(data) {
        const dash = document.getElementById("ibcDashboardArea");
        if (dash) dash.style.display = "block";
        const insp = document.getElementById("ibcDrilldownInspector");
        if (insp) insp.style.display = "none";

        // 1. Skipped Invalid / Missing Pairs Banner
        const skipBanner = document.getElementById("ibcSkippedBanner");
        const skipList = document.getElementById("ibcSkippedList");
        const skipped = data.skipped_invalid || [];
        if (skipBanner && skipList) {
            if (skipped.length > 0) {
                const cntEl = document.getElementById("ibcSkippedCount");
                if (cntEl) cntEl.textContent = skipped.length;
                skipList.innerHTML = skipped.map(s =>
                    `<li><strong>Row ${s.row_num}</strong> (${s.new_id} vs ${s.old_id}): ${s.reason}</li>`
                ).join("");
                skipList.style.display = "none";
                skipBanner.style.display = "block";
            } else {
                skipBanner.style.display = "none";
            }
        }

        const bsegs = data.bseg_summary || [];
        const bills = data.bill_summary || [];

        // 2. Populate Main Rate Schedule Filter
        const rateSelect = document.getElementById("ibcRateFilter");
        if (rateSelect) {
            const uniqueRates = Array.from(new Set(bsegs.map(r => r.Rate_cd).filter(Boolean))).sort();
            rateSelect.innerHTML = `<option value="ALL">All Rates (${uniqueRates.length})</option>` +
                uniqueRates.map(r => `<option value="${r}">${r}</option>`).join("");
        }

        // 3. Build tStats FIRST (before reading Object.keys(tStats))
        let tStats = data.table_chart_stats || {};
        if (Object.keys(tStats).length === 0) {
            if (data.scope !== "bseg_only" && bills.length) {
                tStats["CI_BILL_MSGS"] = {
                    match: bills.reduce((a, r) => a + (r.CI_BILL_MSGS_match || 0), 0),
                    mismatch: bills.reduce((a, r) => a + (r.CI_BILL_MSGS_mismatch || 0), 0)
                };
            }
            ["CI_BSEG_CALC", "CI_BSEG_READ", "CI_BSEG_SQ", "CI_BSEG_CALC_LN", "CI_FT_GL", "CI_BSEG_MSG"].forEach(t => {
                tStats[t] = {
                    match: bsegs.reduce((a, r) => a + (r[`${t}_match`] || 0), 0),
                    mismatch: bsegs.reduce((a, r) => a + (r[`${t}_mismatch`] || 0), 0)
                };
            });
        }

        // 4. Load Functional Metadata (Order 1-7) & Default Select 1-5
        _ibcTableMetaMap = {};
        (data.table_meta || []).forEach(m => { _ibcTableMetaMap[m.table] = m; });
        _ibcRateCategories = data.rate_categories || {};

        _ibcAllJobTables = Object.keys(tStats).sort((a, b) =>
            ((_ibcTableMetaMap[a]?.order) || 99) - ((_ibcTableMetaMap[b]?.order) || 99)
        );
        const defaultActive = _ibcAllJobTables.filter(t => _ibcTableMetaMap[t] ? _ibcTableMetaMap[t].default_selected : true);
        _ibcSelectedTables = new Set(defaultActive.length ? defaultActive : _ibcAllJobTables);

        // 5. Populate Rate Breakdown Section's Own Filters (Type & Meter Type from season_config)
        const typesSet = new Set(), metersSet = new Set(), ownRatesSet = new Set();
        bsegs.forEach(b => {
            const rc = (b.Rate_cd || "").toUpperCase();
            if (rc && rc !== "-") ownRatesSet.add(rc);
            const cat = _ibcRateCategories[rc];
            typesSet.add(cat ? cat.type : "Other");
            metersSet.add(cat ? cat.meter_type : "Other");
        });
        const tSel = document.getElementById("ibcRateCatTypeFilter");
        if (tSel) tSel.innerHTML = `<option value="ALL">All Types</option>` + Array.from(typesSet).sort().map(v => `<option value="${v}">${v}</option>`).join("");
        const mSel = document.getElementById("ibcRateCatMeterFilter");
        if (mSel) mSel.innerHTML = `<option value="ALL">All Meter Types</option>` + Array.from(metersSet).sort().map(v => `<option value="${v}">${v}</option>`).join("");
        const rSel = document.getElementById("ibcRateOwnRateFilter");
        if (rSel) rSel.innerHTML = `<option value="ALL">All Rates</option>` + Array.from(ownRatesSet).sort().map(v => `<option value="${v}">${v}</option>`).join("");

        // 6. Collapse Rate Breakdown by Default
        const rbBody = document.getElementById("ibcRateBreakdownBody");
        const rbBtn = document.getElementById("ibcRateCollapseBtn");
        if (rbBody) rbBody.style.display = "none";
        if (rbBtn) rbBtn.textContent = "▶ Expand";

        // 7. Scope-Aware Tabs & Overall Pie Toggle
        const billTabBtn = document.getElementById("tabBtnBillLevel");
        const pieBillBtn = document.getElementById("pieBtnBill");
        if (data.scope === "bseg_only") {
            if (billTabBtn) billTabBtn.style.display = "none";
            if (pieBillBtn) pieBillBtn.style.display = "none";
            _ibcOverallPieMode = "bseg";
            switchIbcTableTab("bseg");
        } else {
            if (billTabBtn) billTabBtn.style.display = "inline-block";
            if (pieBillBtn) pieBillBtn.style.display = "inline-block";
            switchIbcTableTab("bill");
        }

        // 8. Render Ribbons, KPIs, All 3 Pie Charts, Bar Chart, Rate Breakdown & Tables
        renderIbcTableRibbons();
        applyIbcRibbonFilterToDashboard();
    }