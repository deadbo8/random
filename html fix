def generate_executive_word_report(
        self,
        kpis: dict,
        table_stats: dict,
        results: dict,
        charts_buf: dict,
        output_dir: str,
        task_id: str
    ) -> str:
        """Generates scope-aware Executive Word (.docx) Report with 3 Pie Charts, Bar Chart & Frontend Summary Tables."""
        from docx import Document
        from docx.shared import Inches, Pt, RGBColor
        from docx.enum.text import WD_ALIGN_PARAGRAPH
        from docx.enum.table import WD_TABLE_ALIGNMENT
        from docx.oxml import OxmlElement
        from docx.oxml.ns import qn
        from datetime import datetime

        def set_cell_bg(cell, hex_color):
            tcPr = cell._tc.get_or_add_tcPr()
            shd = OxmlElement("w:shd")
            shd.set(qn("w:val"), "clear")
            shd.set(qn("w:color"), "auto")
            shd.set(qn("w:fill"), hex_color)
            tcPr.append(shd)

        def remove_table_borders(table):
            tblPr = table._tbl.tblPr
            borders = OxmlElement("w:tblBorders")
            for b_name in ("top", "left", "bottom", "right", "insideH", "insideV"):
                b = OxmlElement(f"w:{b_name}")
                b.set(qn("w:val"), "none")
                borders.append(b)
            tblPr.append(borders)

        doc = Document()
        for sec in doc.sections:
            sec.top_margin = Inches(0.55)
            sec.bottom_margin = Inches(0.55)
            sec.left_margin = Inches(0.6)
            sec.right_margin = Inches(0.6)

        scope = results.get("scope", self.scope)
        is_bill_scope = (scope == "bill_and_bseg")
        active_tables_str = ", ".join(table_stats.keys()) if table_stats else "None"

        # ---------------- 1. TITLE BANNER & METADATA ----------------
        ver_p = doc.add_paragraph()
        ver_p.alignment = WD_ALIGN_PARAGRAPH.LEFT
        ver_p.paragraph_format.space_after = Pt(2)
        r_ver = ver_p.add_run(f"RATE CALC TOOL  |  VERSION: {APP_VERSION}")
        r_ver.font.size = Pt(9)
        r_ver.font.bold = True
        r_ver.font.color.rgb = RGBColor(0, 114, 206)

        title_p = doc.add_paragraph()
        title_p.alignment = WD_ALIGN_PARAGRAPH.LEFT
        title_p.paragraph_format.space_after = Pt(4)
        r_title = title_p.add_run("PG&E CC&B 25.4 Upgrade — IBC Executive Validation Report")
        r_title.font.size = Pt(17)
        r_title.font.bold = True
        r_title.font.color.rgb = RGBColor(0, 51, 102)

        sub_p = doc.add_paragraph()
        r_sub = sub_p.add_run(
            f"Generated: {datetime.now().strftime('%B %d, %Y at %I:%M %p')}  |  "
            f"Environment: {self.env.upper()}  |  "
            f"Scope: {'Bill + BSEG Level' if is_bill_scope else 'BSEG Level Only'}\n"
            f"Included Tables: {active_tables_str}"
        )
        r_sub.font.size = Pt(8.5)
        r_sub.font.color.rgb = RGBColor(100, 116, 139)

        # ---------------- 2. EXECUTIVE NARRATIVE & KPI SCORECARD ----------------
        tot_bills = kpis.get("total_bills", 0)
        tot_bsegs = kpis.get("total_bsegs", 0)
        matched = kpis.get("matched_rows", 0)
        mismatched = kpis.get("mismatched_rows", 0)
        exceptions = kpis.get("approved_exceptions", 0)
        tot_rows = kpis.get("total_rows", matched + mismatched)
        pass_rate = round((matched / max(tot_rows, 1)) * 100, 1)

        bseg_sum = results.get("bseg_summary", [])
        bseg_passed = sum(1 for b in bseg_sum if (b.get("Total_row_validated_mismatch", 0) or 0) == 0)
        verdict = "PASSED (100% RECONCILED)" if mismatched == 0 else f"ACTION REQUIRED ({mismatched:,} VARIANCES DETECTED)"

        h1 = doc.add_heading("1. Executive Summary & Business Narrative", level=2)
        h1.runs[0].font.color.rgb = RGBColor(0, 51, 102)

        story = doc.add_paragraph()
        scope_text = (
            f"across {tot_bills} Bill pair(s) and {tot_bsegs} paired Bill Segment(s) (BSEGs)"
            if is_bill_scope
            else f"across {tot_bsegs} paired Bill Segment(s) (BSEGs) in BSEG-Only validation mode"
        )
        story.add_run(
            f"This report presents the automated Inter-Bill Comparison (IBC) validation results for the "
            f"Oracle CC&B 25.4 Upgrade in the {self.env.upper()} environment. The engine executed an "
            f"order-independent, cell-by-cell SQL reconciliation {scope_text}, evaluating {tot_rows:,} "
            f"records across the selected CC&B tables.\n\n"
        )
        r_vl = story.add_run("Overall Validation Verdict: ")
        r_vl.bold = True
        r_vv = story.add_run(f"{verdict}\n")
        r_vv.bold = True
        r_vv.font.color.rgb = RGBColor(22, 163, 74) if mismatched == 0 else RGBColor(220, 38, 38)

        story.add_run(
            f"• Row Accuracy: {pass_rate}% ({matched:,} matched vs. {mismatched:,} mismatched out of {tot_rows:,} rows).\n"
            f"• BSEG Pass Summary: {bseg_passed} of {tot_bsegs} Bill Segments passed with zero mismatches.\n"
            f"• Approved 25.4 Exceptions: {exceptions:,} extra zero-dollar calculation lines accepted via business whitelist."
        )

        kpi_tbl = doc.add_table(rows=2, cols=5)
        kpi_tbl.alignment = WD_TABLE_ALIGNMENT.CENTER
        kpi_headers = [
            "Bills / BSEGs" if is_bill_scope else "BSEG Pairs",
            "Total Records", "Matched Records", "Mismatched Records", "Row Pass Rate"
        ]
        kpi_vals = [
            f"{tot_bills} / {tot_bsegs}" if is_bill_scope else f"{tot_bsegs}",
            f"{tot_rows:,}", f"{matched:,}", f"{mismatched:,}", f"{pass_rate}%"
        ]
        for i, h_text in enumerate(kpi_headers):
            c_hdr = kpi_tbl.cell(0, i)
            set_cell_bg(c_hdr, "003366")
            p = c_hdr.paragraphs[0]
            p.alignment = WD_ALIGN_PARAGRAPH.CENTER
            run = p.add_run(h_text)
            run.bold = True
            run.font.size = Pt(9)
            run.font.color.rgb = RGBColor(255, 255, 255)

            c_val = kpi_tbl.cell(1, i)
            set_cell_bg(c_val, "F8FAFC")
            pv = c_val.paragraphs[0]
            pv.alignment = WD_ALIGN_PARAGRAPH.CENTER
            rv = pv.add_run(kpi_vals[i])
            rv.bold = True
            rv.font.size = Pt(11.5)
            rv.font.color.rgb = RGBColor(0, 51, 102)

        # ---------------- 3. VISUAL VALIDATION BREAKDOWN (3 PIES + BOTTOM BAR) ----------------
        h2 = doc.add_heading("2. Visual Validation Breakdown", level=2)
        h2.runs[0].font.color.rgb = RGBColor(0, 51, 102)

        # Top Row: 3 Pie Charts Side-by-Side (Overall BSEG | SQ Details | Calc Lines)
        pie_tbl = doc.add_table(rows=1, cols=3)
        pie_tbl.alignment = WD_TABLE_ALIGNMENT.CENTER
        remove_table_borders(pie_tbl)

        pie_keys = ["overall_bseg_png", "sq_png", "calc_ln_png"]
        for idx, pk in enumerate(pie_keys):
            buf = charts_buf.get(pk)
            if buf:
                buf.seek(0)
                p_cell = pie_tbl.cell(0, idx).paragraphs[0]
                p_cell.alignment = WD_ALIGN_PARAGRAPH.CENTER
                p_cell.add_run().add_picture(buf, width=Inches(2.35))

        # Bottom Row: Full-Width Bar Chart
        if charts_buf.get("table_png"):
            charts_buf["table_png"].seek(0)
            p_bar = doc.add_paragraph()
            p_bar.alignment = WD_ALIGN_PARAGRAPH.CENTER
            p_bar.add_run().add_picture(charts_buf["table_png"], width=Inches(7.0))

        # ---------------- 4. CC&B DATABASE TABLE HEALTH MATRIX ----------------
        h3 = doc.add_heading("3. CC&B Database Table Reconciliation Matrix", level=2)
        h3.runs[0].font.color.rgb = RGBColor(0, 51, 102)

        all_registries = {**BILL_TABLE_REGISTRY, **BSEG_TABLE_REGISTRY}
        t_matrix = doc.add_table(rows=1, cols=6)
        t_matrix.alignment = WD_TABLE_ALIGNMENT.CENTER
        m_hdrs = ["CC&B Table", "Business Scope", "Matched", "Mismatched", "Accuracy", "Status"]
        for i, h_text in enumerate(m_hdrs):
            cell = t_matrix.cell(0, i)
            set_cell_bg(cell, "003366")
            run = cell.paragraphs[0].add_run(h_text)
            run.bold = True
            run.font.size = Pt(9)
            run.font.color.rgb = RGBColor(255, 255, 255)

        for tbl_name, st in table_stats.items():
            m_c, mm_c = st["match"], st["mismatch"]
            tot_c = m_c + mm_c
            acc_str = f"{round((m_c / tot_c) * 100, 1)}%" if tot_c > 0 else "N/A (0 rows)"
            status_str = "PASS" if mm_c == 0 else f"VARIANCE ({mm_c})"
            tbl_desc = all_registries.get(tbl_name, {}).get(
                "description", f"CC&B {tbl_name.replace('CI_', '').replace('_', ' ').title()} Table"
            )

            row_cells = t_matrix.add_row().cells
            vals = [tbl_name, tbl_desc, f"{m_c:,}", f"{mm_c:,}", acc_str, status_str]
            for i, v in enumerate(vals):
                row_cells[i].paragraphs[0].add_run(v).font.size = Pt(8.5)
            if mm_c > 0:
                set_cell_bg(row_cells[5], "FEE2E2")
                row_cells[5].paragraphs[0].runs[0].font.bold = True
                row_cells[5].paragraphs[0].runs[0].font.color.rgb = RGBColor(185, 28, 28)
            else:
                set_cell_bg(row_cells[5], "DCFCE7")
                row_cells[5].paragraphs[0].runs[0].font.bold = True
                row_cells[5].paragraphs[0].runs[0].font.color.rgb = RGBColor(21, 128, 61)

        # ---------------- 5. FRONTEND SUMMARY TABLES (DYNAMIC BY SCOPE) ----------------
        next_sec = 4

        # 5A. Bill-Level Summary Table (Printed ONLY when scope == "bill_and_bseg")
        if is_bill_scope:
            h_bill = doc.add_heading(f"{next_sec}. Bill Level Summary", level=2)
            h_bill.runs[0].font.color.rgb = RGBColor(0, 51, 102)
            next_sec += 1

            bill_tbl = doc.add_table(rows=1, cols=7)
            bill_tbl.alignment = WD_TABLE_ALIGNMENT.CENTER
            bill_hdrs = ["New Bill ID", "Cancelled Bill ID", "BSEGs", "Match", "Mismatch", "Total Rows", "Status"]
            for i, h_text in enumerate(bill_hdrs):
                cell = bill_tbl.cell(0, i)
                set_cell_bg(cell, "003366")
                run = cell.paragraphs[0].add_run(h_text)
                run.bold = True
                run.font.size = Pt(8.5)
                run.font.color.rgb = RGBColor(255, 255, 255)

            for bi in results.get("bill_summary", []):
                rc = bill_tbl.add_row().cells
                mm_b = bi.get("Total_row_validated_mismatch", 0)
                st_b = "PASS" if mm_b == 0 else f"VARIANCE ({mm_b})"
                b_vals = [
                    bi["New Bill id"], bi["cancelled Bill ID"],
                    str(bi["total_bseg_ID_validate"]),
                    f"{bi['Total_row_validated_match']:,}",
                    f"{mm_b:,}",
                    f"{bi['Total_row_validated_total']:,}",
                    st_b
                ]
                for i, val in enumerate(b_vals):
                    rc[i].paragraphs[0].add_run(str(val)).font.size = Pt(8.5)
                set_cell_bg(rc[6], "DCFCE7" if mm_b == 0 else "FEE2E2")
                rc[6].paragraphs[0].runs[0].font.bold = True
                rc[6].paragraphs[0].runs[0].font.color.rgb = RGBColor(21, 128, 61) if mm_b == 0 else RGBColor(185, 28, 28)

        # 5B. BSEG-Level Summary Table (Printed for BOTH "bill_and_bseg" AND "bseg_only")
        h_bseg = doc.add_heading(f"{next_sec}. Bill Segment (BSEG) Level Summary", level=2)
        h_bseg.runs[0].font.color.rgb = RGBColor(0, 51, 102)

        active_bseg_tbls = results.get("active_bseg_tables", list(BSEG_TABLE_REGISTRY.keys()))

        # Prioritize mismatched segments first if batch > 100 rows so document stays clean
        sorted_bsegs = sorted(bseg_sum, key=lambda x: x.get("Total_row_validated_mismatch", 0), reverse=True)
        display_bsegs = sorted_bsegs[:100]
        if len(sorted_bsegs) > 100:
            note_p = doc.add_paragraph(
                f"Note: Displaying top 100 of {len(sorted_bsegs)} segments (prioritized by variances). "
                f"Refer to the Master Summary Excel for all {len(sorted_bsegs)} rows."
            )
            note_p.runs[0].font.size = Pt(8.5)
            note_p.runs[0].font.italic = True

        bseg_tbl = doc.add_table(rows=1, cols=7)
        bseg_tbl.alignment = WD_TABLE_ALIGNMENT.CENTER
        b_hdrs = ["New Bill -> Old Bill", "SA_ID", "New BSEG -> Old BSEG", "Rate", "Match", "Mismatch", "Key Findings"]
        for i, h_text in enumerate(b_hdrs):
            cell = bseg_tbl.cell(0, i)
            set_cell_bg(cell, "003366")
            run = cell.paragraphs[0].add_run(h_text)
            run.bold = True
            run.font.size = Pt(8)
            run.font.color.rgb = RGBColor(255, 255, 255)

        for b in display_bsegs:
            rc = bseg_tbl.add_row().cells
            diff_tables = []
            for t_name in active_bseg_tbls:
                mm_val = b.get(f"{t_name}_mismatch", 0)
                if mm_val > 0:
                    diff_tables.append(f"{t_name.replace('CI_', '')}: {mm_val}")
            finding_str = ", ".join(diff_tables) if diff_tables else "100% Reconciled"

            mm_cnt = b.get("Total_row_validated_mismatch", 0)
            row_vals = [
                f"{b['New Bill id']}\n{b['cancelled Bill ID']}",
                b["SA_ID"],
                f"{b['New_bseg']}\n{b['old_bseg']}",
                b["Rate_cd"],
                f"{b['Total_row_validated_match']:,}",
                f"{mm_cnt:,}",
                finding_str
            ]
            for i, val in enumerate(row_vals):
                rc[i].paragraphs[0].add_run(str(val)).font.size = Pt(8)
            set_cell_bg(rc[6], "DCFCE7" if mm_cnt == 0 else "FEE2E2")
            rc[6].paragraphs[0].runs[0].font.color.rgb = RGBColor(21, 128, 61) if mm_cnt == 0 else RGBColor(185, 28, 28)

        docx_filename = f"IBC_Executive_Report_{task_id}.docx"
        docx_path = os.path.join(output_dir, docx_filename)
        doc.save(docx_path)
        return docx_path