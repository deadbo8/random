@ibc_bp.route("/api/ibc/exceptions/download", methods=["GET"])
def download_ibc_exceptions():
    exc_path = os.path.join(get_base_dir(), "storage", "compare_exceptions.xlsx")
    if not os.path.exists(exc_path):
        return jsonify({"error": "compare_exceptions.xlsx not found in storage/."}), 404
    return send_file(
        exc_path, as_attachment=True, download_name="compare_exceptions.xlsx",
        mimetype="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    )

@ibc_bp.route("/api/ibc/exceptions/upload", methods=["POST"])
def upload_ibc_exceptions():
    f = request.files.get("exceptionsFile")
    if not f or not f.filename.endswith((".xlsx", ".xls")):
        return jsonify({"error": "Please upload a valid .xlsx exception file."}), 400
    storage_dir = os.path.join(get_base_dir(), "storage")
    os.makedirs(storage_dir, exist_ok=True)
    save_path = os.path.join(storage_dir, "compare_exceptions.xlsx")
    f.save(save_path)
    return jsonify({"ok": True, "message": "Exceptions list updated successfully! Re-run validation to apply new rules."})