function updateIbcDownloadLinks() {
        if (!_ibcJobData) return;
        const tblParam = getIbcTablesQueryParam(); // "" or "?tables=..."
        const buildUrl = (baseUrl, includeOverallMode = false) => {
            if (!baseUrl) return "#";
            const params = new URLSearchParams(tblParam.replace(/^\?/, ""));
            if (includeOverallMode && _ibcOverallPieMode === "bill") {
                params.set("overallMode", "bill");
            }
            const qs = params.toString();
            return qs ? `${baseUrl}?${qs}` : baseUrl;
        };

        const mBtn = document.getElementById("ibcMasterDownloadBtn");
        const zBtn = document.getElementById("ibcZipDownloadBtn");
        const wBtn = document.getElementById("ibcWordDownloadBtn");
        if (mBtn) mBtn.href = buildUrl(_ibcJobData.master_download_url, false);
        if (zBtn) zBtn.href = buildUrl(_ibcJobData.zip_download_url, true);
        if (wBtn) wBtn.href = buildUrl(_ibcJobData.word_download_url, true);
    }








