def get_ordered_table_meta(scope: str = "bill_and_bseg") -> list[dict]:
    """Returns all registered tables sorted in exact sequence 1-7 with functional names."""
    items = []
    for k, v in BSEG_TABLE_REGISTRY.items():
        items.append({"table": k, "functional_name": v["functional_name"], "order": v["order"], "default_selected": v["default_selected"], "level": "BSEG"})
    if scope == "bill_and_bseg":
        for k, v in BILL_TABLE_REGISTRY.items():
            items.append({"table": k, "functional_name": v["functional_name"], "order": v["order"], "default_selected": v["default_selected"], "level": "BILL"})
    return sorted(items, key=lambda x: x["order"])

def load_rate_categories(base_dir: str) -> dict:
    """Reads Type & Meter Type per Rate Schedule from storage/db_storage.xlsx -> season_config."""
    import os
    path = os.path.join(base_dir, "storage", "db_storage.xlsx")
    mapping = {}
    if not os.path.exists(path):
        return mapping
    try:
        df = pd.read_excel(path, sheet_name="season_config")
        df.columns = [str(c).strip() for c in df.columns]
        for _, r in df.iterrows():
            rs = str(r.get("Rate Schedule", "") or "").strip().upper()
            if rs and rs != "NAN":
                mapping[rs] = {
                    "type": str(r.get("Type", "") or "").strip() or "Other",
                    "meter_type": str(r.get("Meter Type", "") or "").strip() or "Other"
                }
    except Exception as e:
        print(f"[IBC season_config Warning] {e}")
    return mapping