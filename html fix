function setIbcOverallPieMode(mode) {
     _ibcOverallPieMode = mode;
     const bBseg = document.getElementById("pieBtnBseg");
     const bBill = document.getElementById("pieBtnBill");
     if (bBseg) {
         bBseg.style.background = mode === "bseg" ? "#007bff" : "#f8fafc";
         bBseg.style.color = mode === "bseg" ? "#fff" : "#334155";
     }
     if (bBill) {
         bBill.style.background = mode === "bill" ? "#007bff" : "#f8fafc";
         bBill.style.color = mode === "bill" ? "#fff" : "#334155";
     }
     const titleEl = document.getElementById("ibcOverallPieTitle");
     if (titleEl) {
         titleEl.textContent = mode === "bseg" ? "Overall (BSEG Level)" : "Overall (Bill Level)";
     }
     drawIbcChartsByScope();
 }
 window.setIbcOverallPieMode = setIbcOverallPieMode;