function renderIbcRateBreakdown() {
        if (!_ibcJobData) return;
        const tbody = document.getElementById("ibcRateBreakdownTbody");
        const ctxEl = document.getElementById("ibcRateBreakdownContext");
        if (!tbody) return;

        const catType = document.getElementById("ibcRateCatTypeFilter")?.value || "ALL";
        const catMeter = document.getElementById("ibcRateCatMeterFilter")?.value || "ALL";
        const ownRate = document.getElementById("ibcRateOwnRateFilter")?.value || "ALL";
        const allBsegs = _ibcJobData.bseg_summary || [];

        const filtered = allBsegs.filter(r => {
            const rc = (r.Rate_cd || "").toUpperCase();
            const cat = _ibcRateCategories[rc] || { type: "Other", meter_type: "Other" };
            const matchBill = _ibcActiveBillHash === "ALL" || r.bill_pair_hash === _ibcActiveBillHash;
            const matchType = catType === "ALL" || cat.type === catType;
            const matchMeter = catMeter === "ALL" || cat.meter_type === catMeter;
            const matchRate = ownRate === "ALL" || rc === ownRate;
            return matchBill && matchType && matchMeter && matchRate;
        });

        if (ctxEl) {
            const billLbl = _ibcActiveBillHash === "ALL"
                ? "All Bills"
                : `Bill: ${document.getElementById("ibcHashFilterText")?.textContent || _ibcActiveBillHash}`;
            const parts = [billLbl];
            if (catType !== "ALL") parts.push(`Type: ${catType}`);
            if (catMeter !== "ALL") parts.push(`Meter: ${catMeter}`);
            if (ownRate !== "ALL") parts.push(`Rate: ${ownRate}`);
            ctxEl.textContent = `(${parts.join(" • ")})`;
        }

        const byRate = {};
        filtered.forEach(r => {
            const rc = r.Rate_cd || "-";
            if (!byRate[rc]) byRate[rc] = { matched: 0, mismatched: 0 };
            const mm = r._filtered_mismatch !== undefined ? r._filtered_mismatch : (r.Total_row_validated_mismatch || 0);
            if (mm === 0) byRate[rc].matched++;
            else byRate[rc].mismatched++;
        });

        const rateKeys = Object.keys(byRate).sort();
        if (rateKeys.length === 0) {
            tbody.innerHTML = `<tr><td colspan="6" style="padding: 14px; text-align: center; color: #64748b;">No Bill Segments match the selected Type / Meter / Rate filter.</td></tr>`;
            return;
        }

        tbody.innerHTML = rateKeys.map(rc => {
            const m = byRate[rc].matched;
            const mm = byRate[rc].mismatched;
            const tot = m + mm;
            const mPct = ((m / tot) * 100).toFixed(1);
            const mmPct = ((mm / tot) * 100).toFixed(1);
            const cat = _ibcRateCategories[rc.toUpperCase()] || { type: "Other", meter_type: "Other" };

            const tipM = `<b>Rate: ${rc}</b> (${cat.type} / Meter ${cat.meter_type})<br>🟢 Matched BSEGs: ${m} / ${tot} (${mPct}%)`;
            const tipMM = `<b>Rate: ${rc}</b> (${cat.type} / Meter ${cat.meter_type})<br>🔴 Mismatched BSEGs: ${mm} / ${tot} (${mmPct}%)`;

            return `
                <tr style="border-bottom: 1px solid #e2e8f0;">
                    <td style="padding: 8px 10px; font-weight: 700; color: #003366;">${rc}</td>
                    <td style="padding: 8px 10px; text-align: center; font-weight: 600;">${tot}</td>
                    <td style="padding: 8px 10px; text-align: center; font-weight: 700; color: #16a34a;">${m}</td>
                    <td style="padding: 8px 10px; text-align: center; font-weight: 700; color: ${mm > 0 ? '#dc2626' : '#94a3b8'};">${mm}</td>
                    <td style="padding: 8px 10px; text-align: center; font-weight: 700; color: #1e293b;">${mPct}%</td>
                    <td style="padding: 8px 10px;">
                        <div style="display: flex; width: 100%; height: 22px; background: #e2e8f0; border-radius: 4px; overflow: hidden;">
                            ${m > 0 ? `<div style="width: ${mPct}%; background: #16a34a; color: #fff; font-size: 10.5px; font-weight: 700; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                                onmouseover="this.style.opacity='0.8'; showIbcTooltip(event, '${tipM}')"
                                onmousemove="showIbcTooltip(event, '${tipM}')"
                                onmouseout="this.style.opacity='1'; hideIbcTooltip()">${parseFloat(mPct) >= 12 ? m : ''}</div>` : ''}
                            ${mm > 0 ? `<div style="width: ${mmPct}%; background: #dc2626; color: #fff; font-size: 10.5px; font-weight: 700; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                                onmouseover="this.style.opacity='0.8'; showIbcTooltip(event, '${tipMM}')"
                                onmousemove="showIbcTooltip(event, '${tipMM}')"
                                onmouseout="this.style.opacity='1'; hideIbcTooltip()">${parseFloat(mmPct) >= 12 ? mm : ''}</div>` : ''}
                        </div>
                    </td>
                </tr>
            `;
        }).join("");
    }

    function resetIbcRateSectionFilters() {
        ["ibcRateCatTypeFilter", "ibcRateCatMeterFilter", "ibcRateOwnRateFilter"].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.value = "ALL";
        });
        renderIbcRateBreakdown();
    }
    window.resetIbcRateSectionFilters = resetIbcRateSectionFilters;