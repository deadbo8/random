let _ibcTableMetaMap = {};      // technical_name -> {functional_name, order, default_selected, level}
 let _ibcRateCategories = {};    // RATE_CD -> {type, meter_type}

 function getIbcFuncName(tbl) {
     return (_ibcTableMetaMap[tbl] && _ibcTableMetaMap[tbl].functional_name) || tbl;
 }

 async function uploadIbcExceptionsFile(inputEl) {
     if (!inputEl.files || !inputEl.files[0]) return;
     const fd = new FormData();
     fd.append("exceptionsFile", inputEl.files[0]);
     try {
         const res = await fetch("/api/ibc/exceptions/upload", { method: "POST", body: fd });
         const d = await res.json();
         alert(res.ok ? d.message : `Upload failed: ${d.error}`);
     } catch (e) {
         alert("Upload error: " + e.message);
     }
     inputEl.value = "";
 }
 window.uploadIbcExceptionsFile = uploadIbcExceptionsFile;