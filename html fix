function drawIbcChartsByScope() {
        const sqBox = document.getElementById("ibcSqPieBox");
        const lnBox = document.getElementById("ibcCalcLnPieBox");
        const ovBox = document.getElementById("ibcOverallChartBox");
        const barBox = document.getElementById("ibcTableBarChartBox");

        // Build hover context listing active ribbon criteria + technical table names
        const activeList = Array.from(_ibcSelectedTables).map(t => `${getIbcFuncName(t)} (${t})`).join(", ");
        const criteriaTip = `Based on selected criteria: ${activeList}`;

        // 1. PIE 1 (Left): Overall Bill/BSeg Pass %
        if (ovBox) {
            if (_ibcOverallPieMode === "bill" && _ibcJobData && _ibcJobData.scope !== "bseg_only") {
                const bills = _ibcJobData.bill_summary || [];
                let bPass = 0, bFail = 0;
                bills.forEach(bi => {
                    const mm = bi._filtered_mismatch !== undefined ? bi._filtered_mismatch : (bi.Total_row_validated_mismatch || 0);
                    if (mm === 0) bPass++;
                    else bFail++;
                });
                ovBox.innerHTML = _buildTwoSlicePieSvg(bPass, bFail, "Bills", "Bills Passed", criteriaTip);
            } else {
                const bsegs = (_ibcJobData && _ibcJobData.bseg_summary) ? _ibcJobData.bseg_summary : [];
                let bsegMatch = 0, bsegMismatch = 0;
                bsegs.forEach(b => {
                    const mm = b._filtered_mismatch !== undefined ? b._filtered_mismatch : (b.Total_row_validated_mismatch || 0);
                    if (mm === 0) bsegMatch++;
                    else bsegMismatch++;
                });
                ovBox.innerHTML = _buildTwoSlicePieSvg(bsegMatch, bsegMismatch, "BSEGs", "BSEGs Passed", criteriaTip);
            }
        }

        // 2. PIE 2 (Middle): SQIs (Technical name in hover)
        if (sqBox) {
            const sqStat = _ibcCachedTableStats["CI_BSEG_SQ"] || { match: 0, mismatch: 0 };
            sqBox.innerHTML = _buildTwoSlicePieSvg(sqStat.match || 0, sqStat.mismatch || 0, "Rows", "Pass Rate", "Technical Table: CI_BSEG_SQ");
        }

        // 3. PIE 3 (Right): Calc Lines (Technical name in hover)
        if (lnBox) {
            const lnStat = _ibcCachedTableStats["CI_BSEG_CALC_LN"] || { match: 0, mismatch: 0 };
            lnBox.innerHTML = _buildTwoSlicePieSvg(lnStat.match || 0, lnStat.mismatch || 0, "Rows", "Pass Rate", "Technical Table: CI_BSEG_CALC_LN");
        }

        // 4. BOTTOM FULL-WIDTH BAR CHART (Functional names on X-axis, Technical names in hover)
        if (!barBox) return;
        const allTbls = Object.keys(_ibcCachedTableStats).sort((a, b) =>
            ((_ibcTableMetaMap[a]?.order) || 99) - ((_ibcTableMetaMap[b]?.order) || 99)
        );
        const filteredTbls = allTbls.filter(t => {
            if (_ibcChartScope === "bill") return t.startsWith("CI_BILL");
            if (_ibcChartScope === "bseg") return !t.startsWith("CI_BILL");
            return true;
        });

        const maxValRaw = Math.max(...filteredTbls.map(t => Math.max(_ibcCachedTableStats[t].match || 0, _ibcCachedTableStats[t].mismatch || 0)), 1);
        const mag = Math.pow(10, Math.floor(Math.log10(maxValRaw)));
        const norm = maxValRaw / mag;
        let niceCeil = 10;
        if (norm <= 1.2) niceCeil = 1.2;
        else if (norm <= 2) niceCeil = 2;
        else if (norm <= 3) niceCeil = 3;
        else if (norm <= 4) niceCeil = 4;
        else if (norm <= 5) niceCeil = 5;
        else if (norm <= 6) niceCeil = 6;
        else if (norm <= 8) niceCeil = 8;
        const maxVal = Math.max(Math.ceil(niceCeil * mag), 4);

        const baseY = 160, chartH = 122, chartLeft = 52, chartRight = 895;
        const colW = (chartRight - chartLeft) / Math.max(filteredTbls.length, 1);

        let scaleHtml = `<line x1="${chartLeft}" y1="${baseY - chartH}" x2="${chartLeft}" y2="${baseY}" stroke="#cbd5e0" stroke-width="1"/>`;
        const numTicks = 4;
        for (let s = 0; s <= numTicks; s++) {
            const tickVal = Math.round((maxVal / numTicks) * s);
            const tickY = baseY - (tickVal / maxVal) * chartH;
            scaleHtml += `
                <line x1="${chartLeft}" y1="${tickY}" x2="${chartRight}" y2="${tickY}" stroke="${s === 0 ? '#94a3b8' : '#e2e8f0'}" stroke-dasharray="${s === 0 ? 'none' : '4 4'}" stroke-width="${s === 0 ? 1.5 : 1}"/>
                <text x="${chartLeft - 8}" y="${tickY + 3.5}" text-anchor="end" font-size="10" font-weight="600" fill="#64748b">${tickVal.toLocaleString()}</text>
            `;
        }

        let barsHtml = "";
        filteredTbls.forEach((t, i) => {
            const funcName = getIbcFuncName(t);
            const m = _ibcCachedTableStats[t].match || 0;
            const mm = _ibcCachedTableStats[t].mismatch || 0;
            const tot = m + mm;
            const passPct = tot > 0 ? ((m / tot) * 100).toFixed(1) : "0.0";
            const mmPctBar = tot > 0 ? ((mm / tot) * 100).toFixed(1) : "0.0";
            const hm = (m / maxVal) * chartH;
            const hmm = (mm / maxVal) * chartH;
            const xc = chartLeft + i * colW + colW / 2;
            const bw = filteredTbls.length <= 2 ? 38 : 24;

            const tipM = `<b>${funcName}</b> (${t})<br>🟢 Matched: ${m.toLocaleString()} rows (${passPct}%)<br>Total in table: ${tot.toLocaleString()}`;
            const tipMM = `<b>${funcName}</b> (${t})<br>🔴 Mismatch: ${mm.toLocaleString()} rows (${mmPctBar}%)<br>Total in table: ${tot.toLocaleString()}`;

            barsHtml += `
                <rect x="${xc - bw - 2}" y="${baseY - hm}" width="${bw}" height="${Math.max(hm, 2)}" rx="2" fill="#16a34a" style="cursor:pointer;"
                    onmouseover="this.setAttribute('opacity','0.75'); showIbcTooltip(event, '${tipM}')"
                    onmousemove="showIbcTooltip(event, '${tipM}')"
                    onmouseout="this.setAttribute('opacity','1'); hideIbcTooltip()"/>
                ${m > 0 ? `<text x="${xc - bw/2 - 2}" y="${baseY - hm - 4}" text-anchor="middle" font-size="10" font-weight="bold" fill="#15803d">${m.toLocaleString()}</text>` : ''}
                <rect x="${xc + 2}" y="${baseY - hmm}" width="${bw}" height="${Math.max(hmm, 2)}" rx="2" fill="#dc2626" style="cursor:pointer;"
                    onmouseover="this.setAttribute('opacity','0.75'); showIbcTooltip(event, '${tipMM}')"
                    onmousemove="showIbcTooltip(event, '${tipMM}')"
                    onmouseout="this.setAttribute('opacity','1'); hideIbcTooltip()"/>
                ${mm > 0 ? `<text x="${xc + bw/2 + 2}" y="${baseY - hmm - 4}" text-anchor="middle" font-size="10" font-weight="bold" fill="#dc2626">${mm.toLocaleString()}</text>` : ''}
                <text x="${xc}" y="${baseY + 18}" text-anchor="middle" font-size="10.5" font-weight="bold" fill="#334155">${funcName}</text>
            `;
        });

        barBox.innerHTML = `
            <svg viewBox="0 0 920 195" width="100%" height="195">
                ${scaleHtml}
                <rect x="760" y="6" width="11" height="11" rx="2" fill="#16a34a"/><text x="776" y="15" font-size="11" font-weight="bold" fill="#334155">Match</text>
                <rect x="830" y="6" width="11" height="11" rx="2" fill="#dc2626"/><text x="846" y="15" font-size="11" font-weight="bold" fill="#334155">Mismatch</text>
                ${barsHtml}
            </svg>
        `;
    }