function _buildTwoSlicePieSvg(matched, mismatched, unitLabel, subLblText = "Pass Rate") {
     const total = matched + mismatched;
     if (total === 0) {
         return `<svg viewBox="0 0 280 195" width="100%" height="205">
             <circle cx="84" cy="96" r="68" fill="none" stroke="#e2e8f0" stroke-width="26"/>
             <text x="84" y="100" text-anchor="middle" font-size="13" font-weight="600" fill="#94a3b8">No Data</text>
             <text x="168" y="98" font-size="11.5" fill="#64748b">0 ${unitLabel}</text>
         </svg>`;
     }

     const r = 68, cx = 84, cy = 96, circ = 2 * Math.PI * r;
     const mLen = (matched / total) * circ;
     const mmLen = (mismatched / total) * circ;
     const mPct = ((matched / total) * 100).toFixed(1);
     const mmPct = ((mismatched / total) * 100).toFixed(1);

     return `<svg viewBox="0 0 285 195" width="100%" height="205">
         <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="#edf2f7" stroke-width="26"/>
         ${matched > 0 ? `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="#16a34a" stroke-width="26"
             stroke-dasharray="${mLen} ${circ}" stroke-dashoffset="0" transform="rotate(-90 ${cx} ${cy})"
             style="cursor:pointer;"
             onmouseover="this.setAttribute('stroke-width','30'); showIbcTooltip(event, '🟢 <b>Matched ${unitLabel}</b><br>Count: ${matched.toLocaleString()} / ${total.toLocaleString()}<br>Share: ${mPct}%')"
             onmousemove="showIbcTooltip(event, '🟢 <b>Matched ${unitLabel}</b><br>Count: ${matched.toLocaleString()} / ${total.toLocaleString()}<br>Share: ${mPct}%')"
             onmouseout="this.setAttribute('stroke-width','26'); hideIbcTooltip()"/>` : ""}
         ${mismatched > 0 ? `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="#dc2626" stroke-width="26"
             stroke-dasharray="${mmLen} ${circ}" stroke-dashoffset="${-mLen}" transform="rotate(-90 ${cx} ${cy})"
             style="cursor:pointer;"
             onmouseover="this.setAttribute('stroke-width','30'); showIbcTooltip(event, '🔴 <b>Mismatched ${unitLabel}</b><br>Count: ${mismatched.toLocaleString()} / ${total.toLocaleString()}<br>Share: ${mmPct}%')"
             onmousemove="showIbcTooltip(event, '🔴 <b>Mismatched ${unitLabel}</b><br>Count: ${mismatched.toLocaleString()} / ${total.toLocaleString()}<br>Share: ${mmPct}%')"
             onmouseout="this.setAttribute('stroke-width','26'); hideIbcTooltip()"/>` : ""}
         <text x="${cx}" y="${cy - 4}" text-anchor="middle" font-size="16" font-weight="bold" fill="#003366">${mPct}%</text>
         <text x="${cx}" y="${cy + 11}" text-anchor="middle" font-size="10" font-weight="600" fill="#64748b">${total.toLocaleString()} ${unitLabel}</text>
         <text x="${cx}" y="${cy + 23}" text-anchor="middle" font-size="8.5" fill="#94a3b8">${subLblText}</text>

         <rect x="168" y="55" width="11" height="11" rx="2" fill="#16a34a"/>
         <text x="184" y="65" font-size="11.5" font-weight="600" fill="#1e293b">Matched (${matched.toLocaleString()})</text>
         <rect x="168" y="88" width="11" height="11" rx="2" fill="#dc2626"/>
         <text x="184" y="98" font-size="11.5" font-weight="600" fill="#1e293b">Mismatch (${mismatched.toLocaleString()})</text>
         <rect x="168" y="121" width="11" height="11" rx="2" fill="#6f42c1"/>
         <text x="184" y="131" font-size="11.5" font-weight="700" fill="#6f42c1">Total (${total.toLocaleString()})</text>
     </svg>`;
 }